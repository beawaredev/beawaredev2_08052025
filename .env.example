# Local environment example for development
# Copy to `.env` and fill with real secrets. Do NOT commit `.env`.

# Server
PORT=5000
NODE_ENV=development

# Azure SQL / MSSQL (if using Azure SQL)
AZURE_SQL_SERVER=beawaredevdbserver.database.windows.net
AZURE_SQL_PORT=1433
AZURE_SQL_DATABASE=Beawaredevdb
AZURE_SQL_USER=beawaredevadmin
AZURE_SQL_PASSWORD=replace-me

# Optional Postgres fallback envs
DATABASE_URL=postgres://user:password@localhost:5432/dbname
PGHOST=localhost
PGPORT=5432
PGDATABASE=dbname
PGUSER=user
PGPASSWORD=password

# Firebase (frontend expects VITE_ prefix)
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_PROJECT_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

# Email
EMAIL_PASSWORD=replace-me
EMAIL_FROM=beaware.fyi@gmail.com

# Uploads
UPLOAD_DIR=./uploads

# Feature toggles
DISABLE_REPORT_SUBMISSION=false
